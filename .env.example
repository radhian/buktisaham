# BuktiSaham - local-first / free-data configuration
APP_NAME=BuktiSaham
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Host ports exposed by Docker. The API uses 18000 by default because 8000 is
# commonly occupied by other local development services. Container ports do
# not change.
API_HOST_PORT=18000
WEB_HOST_PORT=3000
OLLAMA_HOST_PORT=11434

# FREE-ONLY market data policy. This MVP intentionally has no paid provider adapter.
FREE_ONLY_MARKET_DATA=true
MARKET_DATA_PROVIDER=yfinance
YFINANCE_REQUEST_TIMEOUT_SECONDS=20
YFINANCE_CACHE_TTL_SECONDS=300

# Local AI review via Ollama. No external AI API key is required.
AI_REVIEW_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Docker defaults
DATABASE_URL=postgresql+psycopg://buktisaham:buktisaham@postgres:5432/buktisaham
REDIS_URL=redis://redis:6379/0

# Browser/API
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:18000

# Research policy (illustrative MVP thresholds, not investment advice)
POLICY_BUY_EXPECTED_RETURN=0.15
POLICY_SELL_EXPECTED_RETURN=-0.10
POLICY_MAX_BEAR_DOWNSIDE=-0.25
POLICY_MIN_CONFIDENCE=45
POLICY_MIN_LIQUIDITY=50
POLICY_MIN_TECHNICAL=55